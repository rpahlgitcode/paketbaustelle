Func _ShowUninstallFinder()
    Local $sFile = FileOpenDialog("Installer für Check wählen", @ScriptDir, "Installer (*.msi;*.exe)")
    If @error Then Return

    Local $sResult = "", $sFoundFiles = ""
    Local $sExt = StringLower(StringRight($sFile, 3))
    Local $sFileName = StringTrimLeft($sFile, StringInStr($sFile, "\", 0, -1))
    Local $sFilePath = StringLeft($sFile, StringInStr($sFile, "\", 0, -1))

    If $sExt = "msi" Then
        ; --- MSI COM READER (unverändert) ---
        Local $oInstaller = ObjCreate("WindowsInstaller.Installer")
        If IsObj($oInstaller) Then
            Local $oDatabase = $oInstaller.OpenDatabase($sFile, 0)
            If IsObj($oDatabase) Then
                Local $oView = $oDatabase.OpenView("SELECT `Value` FROM `Property` WHERE `Property` = 'ProductCode'")
                $oView.Execute()
                Local $oRecord = $oView.Fetch()
                If IsObj($oRecord) Then
                    $sResult = ":: MSI PRODUCT CODE (GUID)" & @CRLF & "msiexec /x " & $oRecord.StringData(1) & " /qn /norestart"
                EndIf
            EndIf
        EndIf
    Else
        ; --- EXE ULTRA FS SCAN (v1.1 Logik integriert) ---
        Local $sProdName = FileGetVersion($sFile, "ProductName")
        If $sProdName = "" Then $sProdName = FileGetVersion($sFile, "FileDescription")
        If $sProdName = "" Then
            $sProdName = StringRegExpReplace($sFileName, "(?i)([-_]?x\d{2}|[\d\._]+|setup|install|de_DE|en_US)", "")
            $sProdName = StringTrimRight($sProdName, 4)
        EndIf
        $sProdName = StringStripWS($sProdName, 3)

        ; Suche-Varianten (mit/ohne Sonderzeichen für 7-Zip etc.)
        Local $sCleanName = StringRegExpReplace($sProdName, "[^a-zA-Z0-9]", "")
        Local $sShortSearch = StringLeft($sCleanName, 4)

        $sResult = "Analyse für: " & $sProdName & @CRLF & "-----------------------------------" & @CRLF

        Local $aCheckPaths[3] = [@ProgramFilesDir, @HomeDrive & "\Program Files (x86)", $sFilePath]

        For $sPath In $aCheckPaths
            If Not FileExists($sPath) Then ContinueLoop
            Local $hDirSearch = FileFindFirstFile($sPath & "\*")
            If $hDirSearch <> -1 Then
                While 1
                    Local $sDirFound = FileFindNextFile($hDirSearch)
                    If @error Then ExitLoop

                    ; Prüfung auf Original-Name ODER Fuzzy-Name
                    If StringInStr($sDirFound, $sProdName) Or StringInStr($sDirFound, $sShortSearch) Or ($sCleanName <> "" And StringInStr($sDirFound, $sCleanName)) Then
                        Local $sFullDirPath = $sPath & "\" & $sDirFound

                        ; Erweitertes Suchmuster (inkl. Uninstall.exe)
                        Local $aPatterns[4] = ["uninstall.exe", "uninst*.exe", "unins00*.exe", "setup.exe"]
                        For $p In $aPatterns
                            Local $hUnSearch = FileFindFirstFile($sFullDirPath & "\" & $p)
                            If $hUnSearch <> -1 Then
                                While 1
                                    Local $sUnFile = FileFindNextFile($hUnSearch)
                                    If @error Then ExitLoop
                                    $sFoundFiles &= "PFAD GEFUNDEN: " & $sFullDirPath & @CRLF & " -> Befehl: """ & $sFullDirPath & "\" & $sUnFile & """ /S" & @CRLF & @CRLF
                                WEnd
                                FileClose($hUnSearch)
                            EndIf
                        Next
                    EndIf
                WEnd
                FileClose($hDirSearch)
            EndIf
        Next

        If $sFoundFiles <> "" Then
            $sResult &= $sFoundFiles
        Else
            $sResult &= ":: KEINE AUTOMATISCHEN PFADE GEFUNDEN" & @CRLF & _
                       "Tipp: Schauen Sie manuell unter: " & @ProgramFilesDir & "\" & $sProdName
        EndIf
    EndIf

    ; UI Anzeige (unverändert aus Basis 1.1)
    Local $hUIFinder = GUICreate("Uninstall Finder Result", 650, 420, -1, -1, -1, $WS_EX_TOOLWINDOW, $hGUI)
    Local $idEdit = GUICtrlCreateEdit($sResult, 10, 10, 630, 350, BitOR($ES_READONLY, $WS_VSCROLL, $ES_MULTILINE))
    GUICtrlSetFont($idEdit, 9, 400, 0, "Consolas")
    Local $idClose = GUICtrlCreateButton("Schließen", 275, 375, 100, 30)
    GUISetState(@SW_SHOW, $hUIFinder)

    While 1
        Switch GUIGetMsg()
            Case $idClose, $GUI_EVENT_CLOSE
                GUIDelete($hUIFinder)
                ExitLoop
        EndSwitch
    WEnd
EndFunc

Func _Neu()
