Func _ShowDeploymentWiki()
    Local $hWiki = GUICreate("Deployment Quick-Doc - " & $sAuthor & " Edition", 500, 450, -1, -1, -1, $WS_EX_TOOLWINDOW, $hGUI)
    Local $idEdit = GUICtrlCreateEdit("", 10, 10, 480, 390, BitOR($ES_READONLY, $WS_VSCROLL, $ES_MULTILINE))
    GUICtrlSetFont($idEdit, 9, 400, 0, "Segoe UI")

    Local $sWikiText = "DEPLOYMENT GUIDE (Best Practices)" & @CRLF & _
        "========================================" & @CRLF & @CRLF & _
        "1. VORBEREITUNG (@echo off)" & @CRLF & _
        "Unterdrückt die Befehlsausgabe für ein sauberes Log." & @CRLF & @CRLF & _
        "2. INSTALLATION (msiexec /i)" & @CRLF & _
        "Startet den Windows Installer. Wichtigste Flags:" & @CRLF & _
        "  /qn          - Vollständig leise (Silent)" & @CRLF & _
        "  /norestart   - Verhindert ungewollte Reboots" & @CRLF & _
        "  /L*V 'Pfad'  - Erstellt ein detailliertes Log" & @CRLF & @CRLF & _
        "3. EXE-SETUP (/SILENT /VERYSILENT)" & @CRLF & _
        "Standard bei InnoSetup. /VERYSILENT unterdrückt auch " & @CRLF & _
        "das Initialisierungsfenster." & @CRLF & @CRLF & _
        "4. VARIABLEN (set)" & @CRLF & _
        "Nutzen Sie 'set local', um Umgebungsvariablen nur " & @CRLF & _
        "innerhalb des Skripts gültig zu machen." & @CRLF & @CRLF & _
        "5. STATUSPRÜFUNG (%ERRORLEVEL%)" & @CRLF & _
        "Prüfen Sie nach jedem Befehl mit 'if %errorlevel% neq 0'," & @CRLF & _
        "ob die Installation erfolgreich war (0 = Erfolg)." & @CRLF & @CRLF & _
        "6. ABSCHLUSS (timeout / pause / exit)" & @CRLF & _
