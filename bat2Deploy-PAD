; --- Globale Identität ---
Global $sAppName = "bat2Deploy-PAD"
Global $sAuthor = "Roland Pahl"
Global $sAI = "Gemini AI"
Global $sVersion = "v1.1" ; Version erhöht wegen Bugfix (Linebreaks)
Global $sLicense = "MIT License"

; --- Hauptfenster ---
Global $hGUI = GUICreate($sAppName, 900, 720, -1, -1, BitOR($WS_OVERLAPPEDWINDOW, $WS_CLIPCHILDREN))

; --- Menüs ---
Local $hMenuDatei = GUICtrlCreateMenu("Datei")
Local $hOeffnen = GUICtrlCreateMenuItem("Öffnen", $hMenuDatei)
Local $hSpeichern = GUICtrlCreateMenuItem("Speichern", $hMenuDatei)
Local $hSpeichernUnter = GUICtrlCreateMenuItem("Speichern unter", $hMenuDatei)
GUICtrlCreateMenuItem("", $hMenuDatei)
Local $hBeenden = GUICtrlCreateMenuItem("Beenden", $hMenuDatei)

Local $hMenuBuild = GUICtrlCreateMenu("Deployment")
Local $hRunTest = GUICtrlCreateMenuItem("Skript lokal testen (F5)", $hMenuBuild)
Local $hHighlight = GUICtrlCreateMenuItem("Syntax-Check (Refresh)", $hMenuBuild)

Local $hMenuHilfe = GUICtrlCreateMenu("?")
Local $hDeploymentWiki = GUICtrlCreateMenuItem("Deployment Quick-Doc", $hMenuHilfe)
Local $hAbout = GUICtrlCreateMenuItem("Über " & $sAppName, $hMenuHilfe)

; --- Statusleiste ---
Global $hStatus = _GUICtrlStatusBar_Create($hGUI)
Local $aParts[2] = [600, -1]
_GUICtrlStatusBar_SetParts($hStatus, $aParts)
_GUICtrlStatusBar_SetText($hStatus, "Deployment Architect Mode", 0)
_GUICtrlStatusBar_SetText($hStatus, "© " & $sAuthor, 1)

; --- Kontextmenü ---
Global $hContextMenu = GUICtrlCreateContextMenu()
Global $hCtxCopy = GUICtrlCreateMenuItem("Kopieren", $hContextMenu)
Global $hCtxCut = GUICtrlCreateMenuItem("Ausschneiden", $hContextMenu)
Global $hCtxPaste = GUICtrlCreateMenuItem("Einfügen", $hContextMenu)

; --- Editor Aufbau ---
Global $iZeilenBreite = 50
Global $hZahlenFeld = GUICtrlCreateEdit("", 0, 0, $iZeilenBreite, 675, BitOR($ES_READONLY, $ES_RIGHT))
GUICtrlSetFont($hZahlenFeld, 10, 400, 0, "Consolas")
GUICtrlSetColor($hZahlenFeld, 0x606060)
GUICtrlSetBkColor($hZahlenFeld, 0xECECEC)

Global $hRichEdit = _GUICtrlRichEdit_Create($hGUI, "", $iZeilenBreite, 0, 850, 675, BitOR($ES_MULTILINE, $WS_VSCROLL, $ES_AUTOVSCROLL, $WS_HSCROLL))
_GUICtrlRichEdit_SetFont($hRichEdit, 10, "Consolas")

; --- Globale Variablen ---
Global $sAktuelleDatei = ""
Global $iLetzteZeilenAnzahl = -1
Global $hUser32 = DllOpen("user32.dll")

Dim $aAccel[4][2] = [["^c", $hCtxCopy], ["^v", $hCtxPaste], ["^x", $hCtxCut], ["{F5}", $hRunTest]]
GUISetAccelerators($aAccel)

GUISetState(@SW_SHOW, $hGUI)

; --- Hauptschleife ---
While 1
    Local $nMsg = GUIGetMsg()

    If _IsPressed("02", $hUser32) And WinActive($hGUI) Then
        Local $aM = GUIGetCursorInfo($hGUI)
        If Not @error And $aM[4] = 0 Then
            Local $aP = MouseGetPos()
            DllCall($hUser32, "bool", "TrackPopupMenu", "handle", GUICtrlGetHandle($hContextMenu), "uint", 0, "int", $aP[0], "int", $aP[1], "int", 0, "hwnd", $hGUI, "ptr", 0)
            While _IsPressed("02", $hUser32)
                Sleep(10)
            WEnd
        EndIf
    EndIf

    Switch $nMsg
        Case $GUI_EVENT_CLOSE, $hBeenden
            _GUICtrlRichEdit_Destroy($hRichEdit)
            DllClose($hUser32)
            ExitLoop

        Case $hDeploymentWiki
            _ShowDeploymentWiki()

        Case $hAbout
            MsgBox($MB_ICONINFORMATION, $sAppName, $sAppName & " " & $sVersion & @CRLF & _
                   "-------------------------------------------" & @CRLF & _
                   "AI-native Developer: " & $sAuthor & @CRLF & _
                   "Konzept & Prompt-Engineering: Roland Pahl" & @CRLF & _
                   "KI-Engine: " & $sAI & @CRLF & _
                   "-------------------------------------------" & @CRLF & _
                   "Lizenz: " & $sLicense & @CRLF & _
                   "Open Source: Frei zur Modifikation & Verteilung.")

        Case $hOeffnen
            _DateiOeffnen()
        Case $hSpeichern
            _DateiSpeichern()
        Case $hSpeichernUnter
            _DateiSpeichernUnter()
        Case $hRunTest
            _SkriptTesten()
        Case $hHighlight
            _DoBatchHighlight()
        Case $hCtxCopy
            _GUICtrlRichEdit_Copy($hRichEdit)
        Case $hCtxCut
            _GUICtrlRichEdit_Cut($hRichEdit)
        Case $hCtxPaste
            _GUICtrlRichEdit_Paste($hRichEdit)
    EndSwitch
    _CheckLineNumbers()
WEnd

