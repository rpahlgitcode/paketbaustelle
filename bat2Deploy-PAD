    _GUICtrlRichEdit_SetText($hRichEdit, "")
    _GUICtrlRichEdit_SetModified($hRichEdit, False)
    $sAktuelleDatei = ""
    _GUICtrlStatusBar_SetText($hStatus, "Neues Dokument.", 0)
EndFunc

