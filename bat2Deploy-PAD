Func _TemplateErstellen($sType)
    Local $sProject = InputBox("Projekt-Setup", "Name des Tools:", "MeinTool", "", 300, 130)
    If @error Or $sProject = "" Then Return

    Local $sCode = ""
    If $sType = "INSTALL" Then
        $sCode = "@echo off" & @CRLF & "setlocal enabledelayedexpansion" & @CRLF & @CRLF & _
                 ":: ========================================================================" & @CRLF & _
                 ":: STANDALONE (NoINSTALL) ROLLOUT - " & $sProject & @CRLF & _
                 ":: ========================================================================" & @CRLF & _
                 "set ""TOOLNAME=" & $sProject & """" & @CRLF & _
                 "set ""LOGDIR=C:\ProgramData\softlogs\Logs""" & @CRLF & _
                 "set ""LOGFILE=%LOGDIR%\%TOOLNAME%_install_log.txt""" & @CRLF & _
                 "if not exist ""%LOGDIR%"" mkdir ""%LOGDIR%""" & @CRLF & @CRLF & _
                 "echo Installation gestartet am %date% %time% > ""%LOGFILE%""" & @CRLF & @CRLF & _
                 ":: 1. Prozess beenden" & @CRLF & _
                 "start /wait taskkill /IM ""%TOOLNAME%.exe"" /F /T >nul 2>&1" & @CRLF & @CRLF & _
                 ":: 2. Verzeichnisstruktur" & @CRLF & _
                 "if exist ""C:\Program Files\%TOOLNAME%"" rmdir /s /q ""C:\Program Files\%TOOLNAME%""" & @CRLF & _
                 "mkdir ""C:\Program Files\%TOOLNAME%"" >> ""%LOGFILE%"" 2>&1" & @CRLF & @CRLF & _
                 ":: 3. Programmdatei kopieren" & @CRLF & _
                 "xcopy ""%~dp0%TOOLNAME%.exe"" ""C:\Program Files\%TOOLNAME%\"" /I /E /H /K /R /Y >> ""%LOGFILE%"" 2>&1" & @CRLF & @CRLF & _
                 ":: OPTIONAL: Zusaetzlichen Ordner kopieren" & @CRLF & _
                 "rem if exist ""%~dp0Files"" xcopy ""%~dp0Files\*"" ""C:\Program Files\%TOOLNAME%\"" /S /E /H /Y /R >> ""%LOGFILE%"" 2>&1" & @CRLF & @CRLF & _
                 ":: 4. Verknuepfungen kopieren" & @CRLF & _
                 "xcopy ""%~dp0%TOOLNAME%.lnk"" ""C:\ProgramData\Microsoft\Windows\Start Menu\Programs\"" /Y /R" & @CRLF & _
                 "xcopy ""%~dp0%TOOLNAME%.lnk"" ""C:\Users\Public\Desktop\"" /Y /R" & @CRLF & @CRLF & _
                 "echo SUCCESS > ""%LOGDIR%\%TOOLNAME%_install_ok.txt""" & @CRLF & "timeout 5"
    Else
        $sCode = "@echo off" & @CRLF & "setlocal enabledelayedexpansion" & @CRLF & @CRLF & _
                 ":: STANDALONE (NoINSTALL) DEINSTALLATION - " & $sProject & @CRLF & _
                 "set ""TOOLNAME=" & $sProject & """" & @CRLF & _
                 "set ""LOGDIR=C:\ProgramData\softlogs\Logs""" & @CRLF & _
                 "set ""LOGFILE=%LOGDIR%\%TOOLNAME%_uninstall_log.txt""" & @CRLF & @CRLF & _
                 "taskkill /IM ""%TOOLNAME%.exe"" /F /T >nul 2>&1" & @CRLF & _
                 "rmdir /s /q ""C:\Program Files\%TOOLNAME%"" >> ""%LOGFILE%"" 2>&1" & @CRLF & _
                 "del /f /q ""C:\ProgramData\Microsoft\Windows\Start Menu\Programs\%TOOLNAME%.lnk"" >nul 2>&1" & @CRLF & _
                 "del /f /q ""C:\Users\Public\Desktop\%TOOLNAME%.lnk"" >nul 2>&1" & @CRLF & _
                 "del /f /q ""%LOGDIR%\%TOOLNAME%_install_ok.txt"" >nul 2>&1" & @CRLF & @CRLF & _
                 "echo CLEANUP COMPLETED am %date% %time% >> ""%LOGFILE%""" & @CRLF & "timeout 15"
    EndIf
    _GUICtrlRichEdit_SetText($hRichEdit, $sCode)
    _DoBatchHighlight()
EndFunc

Func _SkriptTesten()
    Local $sTempFile = @TempDir & "\bat2Deploy_Test.bat"
    Local $sRawText = _GUICtrlRichEdit_GetText($hRichEdit)
    Local $sCleanText = StringRegExpReplace($sRawText, "(\r(?!\n)|(?<!\r)\n)", @CRLF)
    Local $hFile = FileOpen($sTempFile, 2 + 256)
    FileWrite($hFile, $sCleanText)
    FileClose($hFile)
    RunWait(@ComSpec & " /k " & FileGetShortName($sTempFile))
    FileDelete($sTempFile)
EndFunc

Func _DoBatchHighlight()
    ; Farbcodes definieren
    Local $cLogik = 0x008000, $cInstall = 0xFF0000, $cNetz = 0x0000FF, $cFile = 0x696969
    Local $cSteuer = 0xFF8C00, $cSystem = 0x800080, $cParam = 0x00A5FF, $cVar = 0x9932CC

    ; Keywords und Schalter
    ; WICHTIG: Leerzeichen um Keywords verhindern Treffer innerhalb anderer Wörter (z.B. ge"start"et)
    Local $aKeywords = [ _
        ["@echo", $cLogik], ["echo ", $cLogik], ["set ", $cLogik], ["rem ", 0x808080], ["if ", $cLogik], ["else ", $cLogik], _
        ["start ", $cInstall], ["msiexec", $cInstall], ["taskkill", $cInstall], ["mkdir ", $cFile], _
        ["copy ", $cFile], ["xcopy ", $cFile], ["timeout ", $cSteuer], ["pause", $cSteuer], _
        ["/wait", $cSteuer], ["/IM", $cParam], ["/qn", $cParam], ["/norestart", $cParam], _
        ["/I", $cParam], ["/E", $cParam], ["/H", $cParam], ["/K", $cParam], ["/R", $cParam], ["/Y", $cParam], ["/S", $cParam], _
        ["%~dp0", $cVar]]

    _GUICtrlRichEdit_PauseRedraw($hRichEdit)

    ; 1. Alles auf Schwarz zurücksetzen
    Local $aSavedSel = _GUICtrlRichEdit_GetSel($hRichEdit)
    _GUICtrlRichEdit_SetSel($hRichEdit, 0, -1)
    _GUICtrlRichEdit_SetCharColor($hRichEdit, 0x000000)

    Local $sText = _GUICtrlRichEdit_GetText($hRichEdit)

    ; 2. Variablen-Highlighting (Alles zwischen % und %)
    Local $aVars = StringRegExp($sText, "%[a-zA-Z0-9_]+%", 3)
    If Not @error Then
        For $sVar In $aVars
            Local $iPos = 1
            While True
                $iPos = StringInStr($sText, $sVar, 0, 1, $iPos)
                If $iPos = 0 Then ExitLoop
                _GUICtrlRichEdit_SetSel($hRichEdit, $iPos - 1, $iPos - 1 + StringLen($sVar))
                _GUICtrlRichEdit_SetCharColor($hRichEdit, $cVar)
                $iPos += StringLen($sVar)
            WEnd
        Next
    EndIf

    ; 3. Keyword-Highlighting
    For $i = 0 To UBound($aKeywords) - 1
        Local $iPos = 1
        Local $sKey = $aKeywords[$i][0]
        While True
            $iPos = StringInStr($sText, $sKey, 0, 1, $iPos)
            If $iPos = 0 Then ExitLoop

            ; Prüfung auf Wortgrenze (verhindert Highlighting in "gestartet")
            Local $bValid = True
            If $iPos > 1 Then
                Local $sPrevChar = StringMid($sText, $iPos - 1, 1)
                ; Wenn davor ein Buchstabe steht, ist es Teil eines anderen Wortes
                If StringRegExp($sPrevChar, "[a-zA-Z0-9]") Then $bValid = False
            EndIf

            If $bValid Then
                _GUICtrlRichEdit_SetSel($hRichEdit, $iPos - 1, $iPos - 1 + StringLen($sKey))
                _GUICtrlRichEdit_SetCharColor($hRichEdit, $aKeywords[$i][1])
            EndIf
            $iPos += StringLen($sKey)
        WEnd
    Next

    _GUICtrlRichEdit_SetSel($hRichEdit, $aSavedSel[0], $aSavedSel[1])
    _GUICtrlRichEdit_ResumeRedraw($hRichEdit)
EndFunc

Func _CheckLineNumbers()
    Local $iCount = _GUICtrlRichEdit_GetLineCount($hRichEdit)
    If $iCount <> $iLetzteZeilenAnzahl Then
        Local $sNumbers = ""
        For $i = 1 To $iCount
            $sNumbers &= $i & @CRLF
        Next
        GUICtrlSetData($hZahlenFeld, $sNumbers)
        $iLetzteZeilenAnzahl = $iCount
    EndIf
EndFunc

Func _TrackPopupMenu($hMenu, $hWnd)
    Local $aPos = MouseGetPos()
    DllCall("user32.dll", "bool", "TrackPopupMenu", "handle", $hMenu, "uint", 0, "int", $aPos[0], "int", $aPos[1], "int", 0, "hwnd", $hWnd, "ptr", 0)
EndFunc

Func _DateiOeffnen()
    Local $sFile = FileOpenDialog("Laden", @ScriptDir, "Batch (*.bat)")
    If Not @error Then
        _GUICtrlRichEdit_SetText($hRichEdit, FileRead($sFile))
        $sAktuelleDatei = $sFile
        _GUICtrlRichEdit_SetModified($hRichEdit, False)
        _DoBatchHighlight()
    EndIf
EndFunc

Func _DateiSpeichern()
    If $sAktuelleDatei = "" Then Return _DateiSpeichernUnter()
    Local $sRawText = _GUICtrlRichEdit_GetText($hRichEdit)
    Local $sCleanText = StringRegExpReplace($sRawText, "(\r(?!\n)|(?<!\r)\n)", @CRLF)
    Local $hFile = FileOpen($sAktuelleDatei, 2 + 256)
    FileWrite($hFile, $sCleanText)
    FileClose($hFile)
    _GUICtrlRichEdit_SetModified($hRichEdit, False)
    _DoBatchHighlight()
EndFunc

Func _DateiSpeichernUnter()
    Local $sFile = FileSaveDialog("Speichern", @ScriptDir, "Batch (*.bat)", 2)
    If Not @error Then
        If Not StringInStr($sFile, ".bat") Then $sFile &= ".bat"
        $sAktuelleDatei = $sFile
        _DateiSpeichern()
    EndIf
EndFunc

