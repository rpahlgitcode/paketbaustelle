    While 1
        Switch GUIGetMsg()
            Case $idClose, $GUI_EVENT_CLOSE
                GUIDelete($hWiki)
                ExitLoop
        EndSwitch
    WEnd
EndFunc

; FIX: Saubere Konvertierung zu CRLF für Batch-Ausführung
Func _SkriptTesten()
    Local $sTempFile = @TempDir & "\bat2Deploy_Test.bat"
    Local $sRawText = _GUICtrlRichEdit_GetText($hRichEdit)
    Local $sCleanText = StringRegExpReplace($sRawText, "(\r(?!\n)|(?<!\r)\n)", @CRLF)

    Local $hFile = FileOpen($sTempFile, 2 + 256) ; UTF-8 ohne BOM (Batch freundlich)
    FileWrite($hFile, $sCleanText)
    FileClose($hFile)

    _GUICtrlStatusBar_SetText($hStatus, "Testing Script...", 0)
    RunWait(@ComSpec & " /k " & FileGetShortName($sTempFile))
    FileDelete($sTempFile)
    _GUICtrlStatusBar_SetText($hStatus, "Deployment Architect Mode", 0)
EndFunc

Func _DoBatchHighlight()
    Local $aKeywords = [ _
        ["@echo", 0x008000], ["set", 0x808080], ["start", 0xFF0000], ["msiexec", 0xFF0000], ["pause", 0x0000FF], _
        ["/SILENT", 0x00A5FF], ["/VERYSILENT", 0x00A5FF], ["/DIR", 0x00A5FF], ["/LOG", 0x00A5FF], ["/qn", 0x00A5FF]]
    _GUICtrlRichEdit_PauseRedraw($hRichEdit)
    Local $aSavedSel = _GUICtrlRichEdit_GetSel($hRichEdit)
    _GUICtrlRichEdit_SetSel($hRichEdit, 0, -1)
    _GUICtrlRichEdit_SetCharColor($hRichEdit, 0x000000)
    Local $sText = _GUICtrlRichEdit_GetText($hRichEdit)
    For $i = 0 To UBound($aKeywords) - 1
        Local $iPos = 1
        While True
            $iPos = StringInStr($sText, $aKeywords[$i][0], 0, 1, $iPos)
            If $iPos = 0 Then ExitLoop
            Local $sPrev = StringMid($sText, $iPos - 1, 1), $sNext = StringMid($sText, $iPos + StringLen($aKeywords[$i][0]), 1)
            Local $sDelim = " " & @CR & @LF & @TAB & "=" & '"' & "/"
            If ($sPrev = "" Or StringInStr($sDelim, $sPrev)) And ($sNext = "" Or StringInStr($sDelim, $sNext)) Then
                _GUICtrlRichEdit_SetSel($hRichEdit, $iPos - 1, $iPos - 1 + StringLen($aKeywords[$i][0]))
                _GUICtrlRichEdit_SetCharColor($hRichEdit, $aKeywords[$i][1])
            EndIf
            $iPos += StringLen($aKeywords[$i][0])
        WEnd
    Next
    _GUICtrlRichEdit_SetSel($hRichEdit, $aSavedSel[0], $aSavedSel[1])
    _GUICtrlRichEdit_ResumeRedraw($hRichEdit)
EndFunc

Func _CheckLineNumbers()
    Local $iCount = _GUICtrlRichEdit_GetLineCount($hRichEdit)
    If $iCount <> $iLetzteZeilenAnzahl Then
        Local $sNumbers = ""
        For $i = 1 To $iCount
            $sNumbers &= $i & @CRLF
        Next
        GUICtrlSetData($hZahlenFeld, $sNumbers)
        $iLetzteZeilenAnzahl = $iCount
    EndIf
EndFunc

Func _DateiOeffnen()
    Local $sFile = FileOpenDialog("Laden", @ScriptDir, "Batch (*.bat)")
    If Not @error Then
        _GUICtrlRichEdit_SetText($hRichEdit, FileRead($sFile))
        $sAktuelleDatei = $sFile
        _DoBatchHighlight()
    EndIf
EndFunc

; FIX: Saubere Konvertierung zu CRLF beim Speichern
Func _DateiSpeichern()
    If $sAktuelleDatei = "" Then Return _DateiSpeichernUnter()

    Local $sRawText = _GUICtrlRichEdit_GetText($hRichEdit)
    Local $sCleanText = StringRegExpReplace($sRawText, "(\r(?!\n)|(?<!\r)\n)", @CRLF)

    Local $hFile = FileOpen($sAktuelleDatei, 2 + 256)
    FileWrite($hFile, $sCleanText)
    FileClose($hFile)
    _DoBatchHighlight()
EndFunc

Func _DateiSpeichernUnter()
    Local $sFile = FileSaveDialog("Speichern", @ScriptDir, "Batch (*.bat)", 2)
    If Not @error Then
        If Not StringInStr($sFile, ".bat") Then $sFile &= ".bat"
        $sAktuelleDatei = $sFile
        _DateiSpeichern()
    EndIf
EndFunc
